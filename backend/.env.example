# SkillProof Backend Environment Configuration
# Copy this file to .env and fill in your values

# ─── Application ────────────────────────────────────────
APP_NAME=SkillProof
DEBUG=true

# ─── Security ────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-super-secret-key-change-this-in-production

# ─── Database (PostgreSQL) ───────────────────────────────
DATABASE_URL=postgresql://skillproof:skillproof123@localhost:5432/skillproof

# ─── Redis ───────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── GitHub OAuth ────────────────────────────────────────
# Create at: https://github.com/settings/applications/new
# Callback URL: http://localhost:8000/api/auth/github/callback
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=http://localhost:8000/api/auth/github/callback

# ─── AI / LLM ────────────────────────────────────────────
# OpenAI (optional)
OPENAI_API_KEY=your_openai_api_key

# Groq (faster, free tier available at console.groq.com)
GROQ_API_KEY=your_groq_api_key

# ─── Email ───────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# ─── CORS ────────────────────────────────────────────────
# Add your frontend URL in production
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
